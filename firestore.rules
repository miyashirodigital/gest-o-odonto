rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Odonto Clinic - Granular Collections for Multi-Device Real-Time Sync
    match /odonto_patients/{patientId} {
      allow read, write: if true;
    }
    match /odonto_appointments/{appointmentId} {
      allow read, write: if true;
    }
    match /odonto_tasks/{taskId} {
      allow read, write: if true;
    }
    match /odonto_chat/{messageId} {
      allow read, write: if true;
    }
    match /odonto_notices/{noticeId} {
      allow read, write: if true;
    }
    match /odonto_studies/{subjectId} {
      allow read, write: if true;
    }
    match /odonto_exams/{examId} {
      allow read, write: if true;
    }
    match /odonto_resources/{resourceId} {
      allow read, write: if true;
    }
    match /odonto_config/{configDoc} {
      allow read, write: if true;
    }

    // Consolidated workspace document
    match /odonto_clinic/{workspaceId} {
      allow read, write: if true;
    }

    // Health check and connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Global fallback for clinic documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
