rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Odonto Clinic shared workspace synchronization
    match /odonto_clinic/{workspaceId} {
      allow read, write: if true;
    }

    // Health check and connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
